/* pages/battle-news/battle-news.wxss */
page {
  background: rgb(17, 34, 51);
}

.content-wrapper {
  width: 90vw; /* Widen wrapper for chart */
  max-width: 600px;
  min-width: 250px;
  margin: 0 auto;
  padding-top: 15vh;
}

.h1 {
  text-align: left;
  margin: 32px 0 8px 0;
  color: white;
  font-size: 24px;
}

.sub-text {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.5);
}

.back-button {
  position: fixed;
  top: 7vh;
  left: 10vw;
  background-color: rgba(255, 255, 255, 0.1);
  height: 30px;
  width: 30px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  backdrop-filter: blur(30px);
}

footer {
  position: fixed !important;
}

/* Chart Styles */
.chart-container {
  margin-top: 20px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  padding: 10px;
  overflow: hidden; /* Fix content exceeding container */
  position: relative;
}

.chart-title {
  color: white;
  font-size: 16px;
  margin-bottom: 10px;
  text-align: center;
}

.canvas-scroll {
  width: 100%;
  height: 320px;
  overflow: hidden; /* Ensure scroll-view itself doesn't leak */
}

.canvas-wrapper {
  display: block;
  box-sizing: border-box;
}

.offscreen-canvas {
  position: absolute;
  top: -9999px;
  left: -9999px;
  visibility: hidden; /* Or visible, but off-screen. Visibility hidden might stop rendering in some browsers, but usually works for canvas API */
}
/* We keep it 'visible' to the renderer but clipped/offscreen to ensure drawing works */
.offscreen-canvas {
  position: fixed;
  left: 100vw;
  top: 0;
  opacity: 0;
}

.loading-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 14px;
}

.legend-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-top: 10px;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-color {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  margin-right: 5px;
}

.legend-text {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8);
}
