/* pages/news/news.wxss */
@import "/styles/fancy-card.wxss";

page {
  background: rgb(17, 34, 51);
}

.content-wrapper {
  width: 60vw;
  max-width: 300px;
  min-width: 250px;
  margin: 0 auto;
  padding-top: 15vh;
}

.h1 {
  text-align: left;
  margin: 32px 0 8px 0;
  color: white;
  font-size: 24px;
}

.sub-text {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.5);
}

.back-button {
  position: fixed;
  top: 7vh;
  left: 10vw;
  background-color: rgba(255, 255, 255, 0.1);
  height: 30px;
  width: 30px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  backdrop-filter: blur(30px);
}

.button-section {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 5vh;
  width: 100%;
}

.btn {
  height: 8vh;
  width: 100%;
}

.hologram-text {
  top: 20%;
}

.hologram-orbit {
  right: -65%;
}

.hologram-championships {
  right: -55%;
}

.hologram-my-page {
  right: -55%;
}

.icon {
  width: 42%;
  position: absolute;
  left: 7%;
  top: 5%;
  opacity: 0.8;
}

footer {
  position: fixed !important;
}